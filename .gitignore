# No trailing slash, on purpose: `node_modules/` matches a directory and NOT a symlink with the
# same name, so with it `scripts/worktree.sh` — which links node_modules instead of copying it —
# would leave every fresh worktree looking dirty, and `git worktree remove` would refuse to clean it.
node_modules
/data
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
secrets.json
# The signing key `holdrim key new` makes (README, "In two minutes"): a private key, never committed.
holdrim-signing.key
*.key
.DS_Store
